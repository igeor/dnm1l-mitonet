{
  "alias": "curriculum_fine_tuning",
  "data_root": "data",
  "results_dir": "results",
  "seed": 42,
  "device": "cuda",
  "num_classes": 3,
  "class_names": ["CONTROL", "DNM1L", "OTHERMIT"],
  "num_splits": 5,
  "train_ratio": 0.8,
