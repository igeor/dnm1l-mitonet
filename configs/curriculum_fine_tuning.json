  "eval_batch_size": 4,
  "lr": 0.0002,
  "weight_decay": 0.001,
  "scheduler_step_size": 1,
  "scheduler_gamma": 0.9,
  "model_name": "efficientnet_b0",
  "dense_layers": [128],
  "dropout": 0.35,
  "pretrained": true,
  "freeze_backbone": false
}
